# Copy to .env and fill in ONLY what you have. Everything is optional —
# the pipeline runs fully on public data with zero credentials.

# --- Reddit (optional: raises rate limits) ---
# Free at https://www.reddit.com/prefs/apps -> create app -> type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Bluesky (optional: enables post search in a later phase) ---
# Free at https://bsky.app -> Settings -> Privacy & Security -> App Passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=
